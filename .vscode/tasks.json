{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Kompilacja gry SFML (cl.exe)",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/MD",
                "/nologo",
                "/std:c++17",
                "/I", "C:\\PROGRAMOWANIE\\CPP\\SFML\\include",
                "${workspaceFolder}\\src\\*.cpp",
                "/Fe:", "${workspaceFolder}\\src\\game.exe",
                "/link",
                "/LIBPATH:C:\\PROGRAMOWANIE\\CPP\\SFML\\lib",
                "sfml-graphics.lib",
                "sfml-window.lib",
                "sfml-system.lib",
                "sfml-audio.lib",
                "sfml-network.lib",
                "user32.lib"
            ],
            "options": {
                "cwd": "${workspaceFolder}\\src"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Kompilator cl.exe z biblioteką SFML (Release)"
        }
    ]
}
